      "html": "<a class=\"ds-af-profile-link\" href=\"https://sidequest.appcalipse.com\">Edit profile <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-af-profile-link{display:flex;justify-content:space-between;align-items:center;gap:12px;max-width:235px;padding:10px 12px;border:1px solid #a4acb4;border-radius:4px;color:var(--ink,#111b28);background:transparent;font:12px 'DM Sans',sans-serif;text-decoration:none;transition:color 150ms ease,background-color 150ms ease}.ds-af-profile-link svg{width:16px}.ds-af-profile-link:hover{background:var(--ink,#111b28);color:var(--bg,#fafaf8)}.ds-af-profile-link:focus-visible{outline:2px solid var(--accent,#b33326);outline-offset:3px;}@media(max-width:560px){.ds-af-profile-link{border:0;padding:3px 0;font-size:11px;gap:8px}.ds-af-profile-link:hover{background:none;color:var(--accent,#b33326)}}@media(prefers-reduced-motion:reduce){.ds-af-profile-link{transition:none}}",
