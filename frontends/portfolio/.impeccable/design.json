      "css": ".ds-af-monogram{display:grid;place-items:center;width:75px;height:75px;background:var(--accent-soft,#f5e7e1);color:var(--accent,#b33326);border-radius:50%;font:400 31px \"DM Serif Display\",Georgia,serif}@media(max-width:800px){.ds-af-monogram{width:58px;height:58px;font-size:25px}}@media(max-width:560px){.ds-af-monogram{width:48px;height:48px;font-size:21px}}",
