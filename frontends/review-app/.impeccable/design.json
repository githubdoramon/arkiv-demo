      "css": ".ds-sq-search{display:block;position:relative;max-width:500px}.ds-sq-search svg{position:absolute;left:14px;top:13px;color:var(--muted,#aeb2b4);pointer-events:none}.ds-sq-search input{width:100%;height:46px;padding:10px 10px 10px 43px;font:13px 'DM Sans',sans-serif;border:1px solid #3c4141;border-radius:10px;background:#1b1d1e;color:var(--ink,#f5f6f0);caret-color:var(--accent,#e5fa36)}.ds-sq-search input::placeholder{color:var(--muted,#aeb2b4)}.ds-sq-search input:focus-visible{outline:2px solid var(--accent,#e5fa36);outline-offset:3px;}",
